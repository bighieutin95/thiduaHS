# Cổng chạy ứng dụng Backend NestJS
PORT=3000

# Đường dẫn kết nối database PostgreSQL (Supabase Transaction Pooler)
# Định dạng: postgresql://[user].[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Thông tin kết nối Supabase API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key...
